  "india-grows-soybean-exports-meal-leads": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/Soyabean_Harvsting_in_Rural_Maharashtra%2C_India.jpg/960px-Soyabean_Harvsting_in_Rural_Maharashtra%2C_India.jpg\" alt=\"Farmers harvesting soybean in rural Maharashtra, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Soybean harvest in Maharashtra, one of the two states — with Madhya Pradesh — that together sow roughly 93 lakh hectares of the crop each year. <a href=\"https://commons.wikimedia.org/wiki/File:Soyabean_Harvsting_in_Rural_Maharashtra,_India.jpg\" rel=\"noopener noreferrer\">Soyabean Harvsting in Rural Maharashtra, India.jpg</a>, Valisport24, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
