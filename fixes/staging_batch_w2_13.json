  "indias-445-billion-spice-export-book-is": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a2/Indian_spice_market.jpg/960px-Indian_spice_market.jpg\" alt=\"Assorted whole spices displayed at an Indian spice market\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">India's spice export book spans chilli, cumin, turmeric and cardamom grown in entirely different states, sold through markets like this one. <a href=\"https://commons.wikimedia.org/wiki/File:Indian_spice_market.jpg\" rel=\"noopener noreferrer\">Indian spice market.jpg</a>, The open draft, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "one-refinery-flipped-nigeria-from": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Worlds_largest_crude_destillation_column_Dangote.jpg/960px-Worlds_largest_crude_destillation_column_Dangote.jpg\" alt=\"The world's largest crude distillation column at the Dangote refinery in Nigeria\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">The Dangote refinery's crude distillation unit — the single plant that flipped Nigeria from a fuel importer to an exporter. <a href=\"https://commons.wikimedia.org/wiki/File:Worlds_largest_crude_destillation_column_Dangote.jpg\" rel=\"noopener noreferrer\">Worlds largest crude destillation column Dangote.jpg</a>, FrankvEck, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "india-will-finance-waste-to-energy": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/Waste_to_Energy_Plant_Shimla.jpg/960px-Waste_to_Energy_Plant_Shimla.jpg\" alt=\"Waste-to-energy plant at Bhariyal near Shimla, Himachal Pradesh\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A waste-to-energy plant in Himachal Pradesh — the kind of facility India funds generously while the sorting infrastructure that would let it work stays underbuilt. <a href=\"https://commons.wikimedia.org/wiki/File:Waste_to_Energy_Plant_Shimla.jpg\" rel=\"noopener noreferrer\">Waste to Energy Plant Shimla.jpg</a>, KshitijShimla, CC BY 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "where-indias-green-hydrogen-bets-are": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/20260130_Haru_Oni.jpg/960px-20260130_Haru_Oni.jpg\" alt=\"Haru Oni green hydrogen and e-fuels plant, an electrolyser-based production facility\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">An electrolyser-based green hydrogen facility of the kind India's 126 registered projects are racing to build (this example, Haru Oni, is in Chile, illustrating the technology rather than an Indian site). <a href=\"https://commons.wikimedia.org/wiki/File:20260130_Haru_Oni.jpg\" rel=\"noopener noreferrer\">20260130 Haru Oni.jpg</a>, Ildottoreverde, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "the-fcc-lever-trading-petrol-yield-for": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/3/32/Jamnagar_Refinery.jpg\" alt=\"Jamnagar Refinery in Gujarat, India, lit up at night\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Jamnagar, the refining complex where FCC gas-recovery modifications like the ones described here would trade petrol yield for LPG. <a href=\"https://commons.wikimedia.org/wiki/File:Jamnagar_Refinery.jpg\" rel=\"noopener noreferrer\">Jamnagar Refinery.jpg</a>, Reliance Industries, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
