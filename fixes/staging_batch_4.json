  "the-1920s-rotor-thats-now-on-22-real": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Cargo_E-Ship_1%2C_Emder_Hafen%2C_CN-03.jpg/960px-Cargo_E-Ship_1%2C_Emder_Hafen%2C_CN-03.jpg\" alt=\"The two Flettner rotors at the bow of the cargo ship E-Ship 1, in port at Emden, Germany\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">The E-Ship 1, Enercon's 2010 rotor-sail cargo ship, revived the century-old Flettner rotor before Norsepower's commercial fleet followed. <a href=\"https://commons.wikimedia.org/wiki/File:Cargo_E-Ship_1,_Emder_Hafen,_CN-03.jpg\" rel=\"noopener noreferrer\">Cargo E-Ship 1, Emder Hafen, CN-03.jpg</a>, Carschten, CC BY-SA 3.0 DE, via Wikimedia Commons.</figcaption></figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\"><rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/><text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Norsepower Rotor Sails: One Year of Growth</text><text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Installed units, Norsepower's own reported figures</text><line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"240\" stroke=\"#212529\" stroke-width=\"1.5\"/><text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Rotor sails, Jun 2025</text><rect x=\"180\" y=\"70\" width=\"388.4\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"572.4\" y=\"79\" font-size=\"10\" fill=\"#212529\">38 sails</text><text x=\"175\" y=\"130\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Vessels fitted, Jun 2025</text><rect x=\"180\" y=\"120\" width=\"224.9\" height=\"10\" fill=\"#0b5394\"/><text x=\"408.9\" y=\"129\" font-size=\"10\" fill=\"#212529\">22 ships</text><text x=\"175\" y=\"180\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Rotor sails, Q1 2026</text><rect x=\"180\" y=\"170\" width=\"460.0\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"644.0\" y=\"179\" font-size=\"10\" fill=\"#212529\">45 sails</text><text x=\"175\" y=\"230\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Vessels fitted, Q1 2026</text><rect x=\"180\" y=\"220\" width=\"255.6\" height=\"10\" fill=\"#0b5394\"/><text x=\"439.6\" y=\"229\" font-size=\"10\" fill=\"#212529\">25 ships</text></svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "the-4-nobody-notices-and-three-other": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/An_Indian_farmer_spreading_fertilizer_over_a_crop.jpg/960px-An_Indian_farmer_spreading_fertilizer_over_a_crop.jpg\" alt=\"An Indian farmer spreading fertilizer over a crop by hand\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Reinsurance, crop insurance, precision-agriculture subsidy and ration portability all trace back to protecting a farming household like this one from a single bad season. <a href=\"https://commons.wikimedia.org/wiki/File:An_Indian_farmer_spreading_fertilizer_over_a_crop.jpg\" rel=\"noopener noreferrer\">An Indian farmer spreading fertilizer over a crop.jpg</a>, kiran kumar, CC BY-SA 2.0, via Wikimedia Commons.</figcaption></figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\"><rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/><text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">GIC Re's Obligatory Cession, Stepped Down</text><text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Share of every general insurance policy ceded to GIC Re (%)</text><line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"258\" stroke=\"#212529\" stroke-width=\"1.5\"/><text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Earlier years</text><rect x=\"180\" y=\"70\" width=\"460.0\" height=\"10\" fill=\"#0b5394\"/><text x=\"644.0\" y=\"79\" font-size=\"10\" fill=\"#212529\">~20%</text><text x=\"175\" y=\"122\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Later step</text><rect x=\"180\" y=\"112\" width=\"345.0\" height=\"10\" fill=\"#0b5394\"/><text x=\"529.0\" y=\"121\" font-size=\"10\" fill=\"#212529\">15%</text><text x=\"175\" y=\"164\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Later step</text><rect x=\"180\" y=\"154\" width=\"230.0\" height=\"10\" fill=\"#0b5394\"/><text x=\"414.0\" y=\"163\" font-size=\"10\" fill=\"#212529\">10%</text><text x=\"175\" y=\"206\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Later step</text><rect x=\"180\" y=\"196\" width=\"115.0\" height=\"10\" fill=\"#0b5394\"/><text x=\"299.0\" y=\"205\" font-size=\"10\" fill=\"#212529\">5%</text><text x=\"175\" y=\"248\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">FY2022-23 onward</text><rect x=\"180\" y=\"238\" width=\"92.0\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"276.0\" y=\"247\" font-size=\"10\" fill=\"#212529\">4% (3rd year running)</text></svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "the-corrosion-you-cant-see-until": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/b/b4/The_SeaRose_FPSO_at_Belfast.jpg\" alt=\"The SeaRose floating production, storage and offloading (FPSO) vessel in dry dock at Belfast\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">An FPSO like the SeaRose combines the insulated hot and cryogenic piping runs this piece describes as especially prone to hidden corrosion under insulation. <a href=\"https://commons.wikimedia.org/wiki/File:The_SeaRose_FPSO_at_Belfast.jpg\" rel=\"noopener noreferrer\">The SeaRose FPSO at Belfast.jpg</a>, Rossographer, CC BY-SA 2.0, via Wikimedia Commons.</figcaption></figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\"><rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/><text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">How Much Damage Traces Back to CUI</text><text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Industry-wide figures cited in this piece (%)</text><line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"210\" stroke=\"#212529\" stroke-width=\"1.5\"/><text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Onshore hydrocarbon leaks</text><rect x=\"180\" y=\"70\" width=\"383.3\" height=\"10\" fill=\"#c0392b\"/><text x=\"567.3\" y=\"79\" font-size=\"10\" fill=\"#212529\">~50%</text><text x=\"175\" y=\"140\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Major EU oil &amp; gas accidents, 35yr</text><rect x=\"180\" y=\"130\" width=\"153.3\" height=\"10\" fill=\"#c0392b\"/><text x=\"337.3\" y=\"139\" font-size=\"10\" fill=\"#212529\">&gt;20%</text><text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Piping maintenance cost</text><rect x=\"180\" y=\"190\" width=\"383.3\" height=\"10\" fill=\"#c0392b\"/><text x=\"567.3\" y=\"199\" font-size=\"10\" fill=\"#212529\">40-60%</text></svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "the-easiest-ev-conversion-in-india": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/TGSRTC_Electric_Express_Bus_1.jpg/960px-TGSRTC_Electric_Express_Bus_1.jpg\" alt=\"A Telangana State Road Transport Corporation (TGSRTC) electric express bus\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A state road transport corporation's own electric bus is exactly the guaranteed, high-mileage government demand this piece argues is India's easiest EV win. <a href=\"https://commons.wikimedia.org/wiki/File:TGSRTC_Electric_Express_Bus_1.jpg\" rel=\"noopener noreferrer\">TGSRTC Electric Express Bus 1.jpg</a>, TG09Z, CC BY-SA 4.0, via Wikimedia Commons.</figcaption></figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\"><rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/><text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">How Small the Government Fleet's EV Share Still Is</text><text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Electrification rate (%), by category and year</text><line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"210\" stroke=\"#212529\" stroke-width=\"1.5\"/><text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Govt-owned vehicles, Feb 2022</text><rect x=\"180\" y=\"70\" width=\"6.9\" height=\"10\" fill=\"#c0392b\"/><text x=\"190.9\" y=\"79\" font-size=\"10\" fill=\"#212529\">0.6%</text><text x=\"175\" y=\"140\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">New vehicle registrations, 2024</text><rect x=\"180\" y=\"130\" width=\"74.8\" height=\"10\" fill=\"#0b5394\"/><text x=\"258.8\" y=\"139\" font-size=\"10\" fill=\"#212529\">6.5%</text><text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">MP govt buses, 2030 target</text><rect x=\"180\" y=\"190\" width=\"460.0\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"644.0\" y=\"199\" font-size=\"10\" fill=\"#212529\">40%</text></svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "the-green-shift-what-indias-oil": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/3/32/Jamnagar_Refinery.jpg\" alt=\"Reliance Industries' Jamnagar Refinery at night\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Reliance's own 2035 net-zero pledge, cited in this piece as the earliest date on ETAC's chart, is anchored at this refining complex. <a href=\"https://commons.wikimedia.org/wiki/File:Jamnagar_Refinery.jpg\" rel=\"noopener noreferrer\">Jamnagar Refinery.jpg</a>, Reliance Industries, CC BY-SA 4.0, via Wikimedia Commons.</figcaption></figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\"><rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/><text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Net-Zero Pledges Among the Top 20 Producers</text><text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Companies (out of 20) with 2050 net-zero commitments, by sector</text><line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"240\" stroke=\"#212529\" stroke-width=\"1.5\"/><text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Oil &amp; gas</text><rect x=\"180\" y=\"70\" width=\"230.0\" height=\"10\" fill=\"#c0392b\"/><text x=\"414.0\" y=\"79\" font-size=\"10\" fill=\"#212529\">10 of 20</text><text x=\"175\" y=\"130\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Vehicle manufacturers</text><rect x=\"180\" y=\"120\" width=\"276.0\" height=\"10\" fill=\"#0b5394\"/><text x=\"460.0\" y=\"129\" font-size=\"10\" fill=\"#212529\">12 of 20</text><text x=\"175\" y=\"180\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Airlines</text><rect x=\"180\" y=\"170\" width=\"299.0\" height=\"10\" fill=\"#0b5394\"/><text x=\"483.0\" y=\"179\" font-size=\"10\" fill=\"#212529\">13 of 20</text><text x=\"175\" y=\"230\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Steel</text><rect x=\"180\" y=\"220\" width=\"299.0\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"483.0\" y=\"229\" font-size=\"10\" fill=\"#212529\">13 of 20</text></svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "the-helper-motor-trick-that-already": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7c/Ras_Laffan_LNG_terminal_in_2012.jpg/960px-Ras_Laffan_LNG_terminal_in_2012.jpg\" alt=\"Ras Laffan LNG terminal in Qatar, home of the RasGas Train 3 helper-motor installation\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">RasGas Train 3, at this Ras Laffan terminal, is the helper-motor installation GE cites as making it one of the most optimized LNG trains ever built. <a href=\"https://commons.wikimedia.org/wiki/File:Ras_Laffan_LNG_terminal_in_2012.jpg\" rel=\"noopener noreferrer\">Ras Laffan LNG terminal in 2012.jpg</a>, Matthew Smith, CC BY 2.0, via Wikimedia Commons.</figcaption></figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\"><rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/><text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Why Electric Drive Wins on Efficiency</text><text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Approximate drivetrain efficiency, by turbine/motor type</text><line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"210\" stroke=\"#212529\" stroke-width=\"1.5\"/><text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Single-shaft industrial gas turbine</text><rect x=\"180\" y=\"70\" width=\"138.0\" height=\"10\" fill=\"#c0392b\"/><text x=\"322.0\" y=\"79\" font-size=\"10\" fill=\"#212529\">25-30%</text><text x=\"175\" y=\"140\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Aeroderivative gas turbine</text><rect x=\"180\" y=\"130\" width=\"193.2\" height=\"10\" fill=\"#0b5394\"/><text x=\"377.2\" y=\"139\" font-size=\"10\" fill=\"#212529\">38-42%</text><text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Electric motor</text><rect x=\"180\" y=\"190\" width=\"437.0\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"621.0\" y=\"199\" font-size=\"10\" fill=\"#212529\">&gt;95%</text></svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "three-different-eu-rules-are-making": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Container_ship_-_Cosco_Belgium_-_Europahaven_Yangtzekanaal_-_Port_of_Rotterdam_%2825432477941%29.jpg/960px-Container_ship_-_Cosco_Belgium_-_Europahaven_Yangtzekanaal_-_Port_of_Rotterdam_%2825432477941%29.jpg\" alt=\"A container ship in the Port of Rotterdam, one of the EU ports where the Sulphur Directive and FuelEU Maritime apply\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A ship calling at an EU port like Rotterdam is bound by the Sulphur Directive and FuelEU Maritime long before the ETS ever prices its carbon. <a href=\"https://commons.wikimedia.org/wiki/File:Container_ship_-_Cosco_Belgium_-_Europahaven_Yangtzekanaal_-_Port_of_Rotterdam_(25432477941).jpg\" rel=\"noopener noreferrer\">Container ship - Cosco Belgium - Europahaven Yangtzekanaal - Port of Rotterdam</a>, Frans Berkelaar, CC BY 2.0, via Wikimedia Commons.</figcaption></figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\"><rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/><text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">FuelEU Maritime: Required GHG-Intensity Cuts</text><text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Reduction vs. 2020 baseline, by milestone year</text><line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"270\" stroke=\"#212529\" stroke-width=\"1.5\"/><text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">2025</text><rect x=\"180\" y=\"70\" width=\"11.5\" height=\"10\" fill=\"#0b5394\"/><text x=\"195.5\" y=\"79\" font-size=\"10\" fill=\"#212529\">-2%</text><text x=\"175\" y=\"116\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">2030</text><rect x=\"180\" y=\"106\" width=\"34.5\" height=\"10\" fill=\"#0b5394\"/><text x=\"218.5\" y=\"115\" font-size=\"10\" fill=\"#212529\">-6%</text><text x=\"175\" y=\"152\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">2035</text><rect x=\"180\" y=\"142\" width=\"83.4\" height=\"10\" fill=\"#0b5394\"/><text x=\"267.4\" y=\"151\" font-size=\"10\" fill=\"#212529\">-14.5%</text><text x=\"175\" y=\"188\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">2040</text><rect x=\"180\" y=\"178\" width=\"178.2\" height=\"10\" fill=\"#0b5394\"/><text x=\"362.2\" y=\"187\" font-size=\"10\" fill=\"#212529\">-31%</text><text x=\"175\" y=\"224\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">2045</text><rect x=\"180\" y=\"214\" width=\"356.5\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"540.5\" y=\"223\" font-size=\"10\" fill=\"#212529\">-62%</text><text x=\"175\" y=\"260\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">2050</text><rect x=\"180\" y=\"250\" width=\"460.0\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"644.0\" y=\"259\" font-size=\"10\" fill=\"#212529\">-80%</text></svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "tnpl-has-made-paper-from-sugarcane": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Sugarcane_bagasse.jpg/960px-Sugarcane_bagasse.jpg\" alt=\"Sugarcane bagasse, the fibrous stalk residue left after crushing cane for juice\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Bagasse like this, not felled pulpwood, is the fibre TNPL has pulped into paper since 1984. <a href=\"https://commons.wikimedia.org/wiki/File:Sugarcane_bagasse.jpg\" rel=\"noopener noreferrer\">Sugarcane bagasse.jpg</a>, Thamizhpparithi Maari, CC BY-SA 3.0, via Wikimedia Commons.</figcaption></figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\"><rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/><text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">TNPL's Pulping Mix at Karur (31 March 2025)</text><text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Pulping capacity by furnish type, tonnes/day</text><line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"210\" stroke=\"#212529\" stroke-width=\"1.5\"/><text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Bagasse pulping</text><rect x=\"180\" y=\"70\" width=\"346.6\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"530.6\" y=\"79\" font-size=\"10\" fill=\"#212529\">550 tpd</text><text x=\"175\" y=\"140\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Hardwood pulping</text><rect x=\"180\" y=\"130\" width=\"460.0\" height=\"10\" fill=\"#0b5394\"/><text x=\"644.0\" y=\"139\" font-size=\"10\" fill=\"#212529\">730 tpd</text><text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Deinked wastepaper pulp</text><rect x=\"180\" y=\"190\" width=\"189.0\" height=\"10\" fill=\"#495057\"/><text x=\"373.0\" y=\"199\" font-size=\"10\" fill=\"#212529\">300 tpd</text></svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "tnpl-has-made-paper-from-sugarcane_01251035403": {
    "picture_html": "<figure style=\"margin:1.6rem 0\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Sugarcane_bagasse.jpg/960px-Sugarcane_bagasse.jpg\" alt=\"Sugarcane bagasse, the fibrous stalk residue left after crushing cane for juice\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Bagasse like this, not felled pulpwood, is the fibre TNPL has pulped into paper since 1984. <a href=\"https://commons.wikimedia.org/wiki/File:Sugarcane_bagasse.jpg\" rel=\"noopener noreferrer\">Sugarcane bagasse.jpg</a>, Thamizhpparithi Maari, CC BY-SA 3.0, via Wikimedia Commons.</figcaption></figure>",
