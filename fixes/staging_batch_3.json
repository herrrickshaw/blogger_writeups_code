  "lng-trucks-cost-about-what-diesel-does": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Ashok_leyland_5525_01.jpg/960px-Ashok_leyland_5525_01.jpg\" alt=\"Ashok Leyland AVTR badge on a heavy truck\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Ashok Leyland's AVTR line &mdash; the same model family as the AVTR 1922, India's first LNG-powered haulage truck, delivered to gas utility Mahanagar Gas in November 2023. <a href=\"https://commons.wikimedia.org/wiki/File:Ashok_leyland_5525_01.jpg\" rel=\"noopener noreferrer\">Ashok Leyland AVTR 5525 tractor truck badge</a>, Photohelp13, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">LNG Truck Fleets in India</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Number of LNG-powered trucks, by operator (2024–2026)</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"255\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"79\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">GreenLine (Apr 2025)</text>\n<rect x=\"180\" y=\"70\" width=\"260\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"446\" y=\"82\" font-size=\"10\" fill=\"#212529\">650 trucks</text>\n<text x=\"175\" y=\"119\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">GreenLine (May 2026)</text>\n<rect x=\"180\" y=\"110\" width=\"400\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"586\" y=\"122\" font-size=\"10\" fill=\"#212529\">1,000+ trucks</text>\n<text x=\"175\" y=\"159\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">UltraTech Cement</text>\n<rect x=\"180\" y=\"150\" width=\"27\" height=\"14\" fill=\"#0b5394\"/><text x=\"213\" y=\"162\" font-size=\"10\" fill=\"#212529\">67 trucks</text>\n<text x=\"175\" y=\"199\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Delhivery (Volvo FM 420)</text>\n<rect x=\"180\" y=\"190\" width=\"8\" height=\"14\" fill=\"#212529\"/><text x=\"194\" y=\"202\" font-size=\"10\" fill=\"#212529\">20 trucks</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "nine-ministries-one-list-every-company": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Sansad_Bhavan%2C_Delhi%2C_BNK.jpg/960px-Sansad_Bhavan%2C_Delhi%2C_BNK.jpg\" alt=\"Sansad Bhavan, the seat of India's Parliament, in New Delhi\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">India's Production Linked Incentive schemes and competitive auctions are approved by the Union Cabinet and announced in Press Information Bureau releases &mdash; the paper trail this piece traces company by company. <a href=\"https://commons.wikimedia.org/wiki/File:Sansad_Bhavan,_Delhi,_BNK.jpg\" rel=\"noopener noreferrer\">Sansad Bhavan, Delhi</a>, Nikhilb239, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">PLI White Goods (AC &amp; LED): Applications vs. Selected</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">By round, DPIIT / Ministry of Commerce &amp; Industry</text>\n<line x1=\"180\" y1=\"60\" x2=\"180\" y2=\"285\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<rect x=\"460\" y=\"56\" width=\"10\" height=\"10\" fill=\"#495057\"/><text x=\"474\" y=\"65\" font-size=\"10\" fill=\"#212529\">Applications</text><rect x=\"460\" y=\"70\" width=\"10\" height=\"10\" fill=\"#1a8f4c\"/><text x=\"474\" y=\"79\" font-size=\"10\" fill=\"#212529\">Selected</text>\n<text x=\"175\" y=\"94\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Round 1 (Nov 2021)</text>\n<rect x=\"180\" y=\"74\" width=\"400\" height=\"12\" fill=\"#495057\"/><text x=\"586\" y=\"84\" font-size=\"9\" fill=\"#212529\">52 applications</text>\n<rect x=\"180\" y=\"92\" width=\"323\" height=\"12\" fill=\"#1a8f4c\"/><text x=\"509\" y=\"102\" font-size=\"9\" fill=\"#212529\">42 selected</text>\n<text x=\"175\" y=\"154\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Round 2 (Jun 2022)</text>\n<rect x=\"180\" y=\"134\" width=\"146\" height=\"12\" fill=\"#495057\"/><text x=\"332\" y=\"144\" font-size=\"9\" fill=\"#212529\">19 applications</text>\n<rect x=\"180\" y=\"152\" width=\"115\" height=\"12\" fill=\"#1a8f4c\"/><text x=\"301\" y=\"162\" font-size=\"9\" fill=\"#212529\">15 selected</text>\n<text x=\"175\" y=\"214\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Round 3 (Jan 2025)</text>\n<rect x=\"180\" y=\"194\" width=\"292\" height=\"12\" fill=\"#495057\"/><text x=\"478\" y=\"204\" font-size=\"9\" fill=\"#212529\">38 applications</text>\n<rect x=\"180\" y=\"212\" width=\"185\" height=\"12\" fill=\"#1a8f4c\"/><text x=\"371\" y=\"222\" font-size=\"9\" fill=\"#212529\">24 selected</text>\n<text x=\"175\" y=\"274\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Round 4 (Jan 2026)</text>\n<rect x=\"180\" y=\"254\" width=\"100\" height=\"12\" fill=\"#495057\"/><text x=\"286\" y=\"264\" font-size=\"9\" fill=\"#212529\">13 applications</text>\n<rect x=\"180\" y=\"272\" width=\"38\" height=\"12\" fill=\"#1a8f4c\"/><text x=\"224\" y=\"282\" font-size=\"9\" fill=\"#212529\">5 selected</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "oisd-writes-indias-oil-safety-rules-api": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/BPCLrefinery-Kochi-4Sep2026_%281%29.jpg/960px-BPCLrefinery-Kochi-4Sep2026_%281%29.jpg\" alt=\"The BPCL Kochi Refinery in Kerala, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">OISD's safety standards and API's privately-published design codes are layered together on Indian refinery projects like this one, the overlap this piece traces. <a href=\"https://commons.wikimedia.org/wiki/File:BPCLrefinery-Kochi-4Sep2026_(1).jpg\" rel=\"noopener noreferrer\">BPCL Kochi Refinery</a>, Rehman Abubakr, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">API Standards Referenced in National Regulations</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Per API's own 2025 International Usage Report</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"225\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"79\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Indonesia</text>\n<rect x=\"180\" y=\"70\" width=\"400\" height=\"14\" fill=\"#495057\"/><text x=\"586\" y=\"82\" font-size=\"10\" fill=\"#212529\">149 standards</text>\n<text x=\"175\" y=\"119\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Canada</text>\n<rect x=\"180\" y=\"110\" width=\"285\" height=\"14\" fill=\"#495057\"/><text x=\"471\" y=\"122\" font-size=\"10\" fill=\"#212529\">106 standards</text>\n<text x=\"175\" y=\"159\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Brazil</text>\n<rect x=\"180\" y=\"150\" width=\"266\" height=\"14\" fill=\"#495057\"/><text x=\"452\" y=\"162\" font-size=\"10\" fill=\"#212529\">99 standards</text>\n<text x=\"175\" y=\"199\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">India</text>\n<rect x=\"180\" y=\"190\" width=\"242\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"428\" y=\"202\" font-size=\"10\" fill=\"#212529\">90 standards</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "one-nation-one-ration-card-doesnt-move": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/16/CWC_Godown%2C_Bamanheri_operated_by_Food_Corporation_of_India_for_stocking_foodgrains.jpg/960px-CWC_Godown%2C_Bamanheri_operated_by_Food_Corporation_of_India_for_stocking_foodgrains.jpg\" alt=\"A Food Corporation of India grain godown storing foodgrain stock\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">FCI's central-pool rice stock, warehoused in godowns like this one, is the surplus this piece follows into both the PDS system and the ethanol-tender pipeline. <a href=\"https://commons.wikimedia.org/wiki/File:CWC_Godown,_Bamanheri_operated_by_Food_Corporation_of_India_for_stocking_foodgrains.jpg\" rel=\"noopener noreferrer\">CWC Godown, Bamanheri, operated by Food Corporation of India</a>, Prabhat1729, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">FCI Rice: Acquisition Cost vs. Ethanol Sale Price</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">₹ per quintal, 2025-26 — a gap of roughly 40%</text>\n<line x1=\"180\" y1=\"90\" x2=\"180\" y2=\"200\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"117\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">FCI acquisition cost</text>\n<rect x=\"180\" y=\"105\" width=\"380\" height=\"18\" fill=\"#212529\"/><text x=\"566\" y=\"121\" font-size=\"10\" fill=\"#212529\">₹3,889.46/quintal</text>\n<text x=\"175\" y=\"177\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Ethanol sale price</text>\n<rect x=\"180\" y=\"165\" width=\"227\" height=\"18\" fill=\"#c0392b\"/><text x=\"413\" y=\"181\" font-size=\"10\" fill=\"#212529\">₹2,320/quintal</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "pngrb-hydrogen-blending-pilots-real": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Compressed_Natural_Gas_%28CNG%29_Filling_Station%2C_Maharastra%2C_India_%281%29.jpg/960px-Compressed_Natural_Gas_%28CNG%29_Filling_Station%2C_Maharastra%2C_India_%281%29.jpg\" alt=\"A Compressed Natural Gas filling station in Maharashtra, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">City gas distribution networks like this one are where PNGRB's three approved hydrogen-blending pilots &mdash; in Indore, Surat and Ahmedabad &mdash; are actually running. <a href=\"https://commons.wikimedia.org/wiki/File:Compressed_Natural_Gas_(CNG)_Filling_Station,_Maharastra,_India_(1).jpg\" rel=\"noopener noreferrer\">Compressed Natural Gas (CNG) Filling Station, Maharashtra, India</a>, K.Venkataramana, CC0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Hydrogen Blending Pilots in India</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">% by volume — approved/current level vs. phased target</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"215\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"84\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Indore — PNG network</text>\n<rect x=\"180\" y=\"75\" width=\"100\" height=\"12\" fill=\"#1a8f4c\"/><text x=\"286\" y=\"85\" font-size=\"10\" fill=\"#212529\">5%</text>\n<text x=\"175\" y=\"114\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Indore — CNG network</text>\n<rect x=\"180\" y=\"105\" width=\"40\" height=\"12\" fill=\"#1a8f4c\"/><text x=\"226\" y=\"115\" font-size=\"10\" fill=\"#212529\">2%</text>\n<text x=\"175\" y=\"144\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Surat — current</text>\n<rect x=\"180\" y=\"135\" width=\"100\" height=\"12\" fill=\"#1a8f4c\"/><text x=\"286\" y=\"145\" font-size=\"10\" fill=\"#212529\">5%</text>\n<text x=\"175\" y=\"174\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Surat — phased target</text>\n<rect x=\"180\" y=\"165\" width=\"400\" height=\"12\" fill=\"#0b5394\"/><text x=\"586\" y=\"175\" font-size=\"10\" fill=\"#212529\">20%</text>\n<text x=\"175\" y=\"204\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Ahmedabad — target</text>\n<rect x=\"180\" y=\"195\" width=\"160\" height=\"12\" fill=\"#0b5394\"/><text x=\"346\" y=\"205\" font-size=\"10\" fill=\"#212529\">8%+</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "right-of-user-what-indias-pipeline": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Petroleum_Pipeline_Marker_-_Beside_Parbatipur_Road_-_Narna_Bheri_Area_-_Howrah.jpg/960px-Petroleum_Pipeline_Marker_-_Beside_Parbatipur_Road_-_Narna_Bheri_Area_-_Howrah.jpg\" alt=\"A petroleum pipeline marker post beside a road in Howrah, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Markers like this one sit above the underground pipelines whose land access is acquired village by village under the 1962 Right of User Act notifications this piece maps. <a href=\"https://commons.wikimedia.org/wiki/File:Petroleum_Pipeline_Marker_-_Beside_Parbatipur_Road_-_Narna_Bheri_Area_-_Howrah.jpg\" rel=\"noopener noreferrer\">Petroleum Pipeline Marker, Narna Bheri Area, Howrah</a>, Biswarup Ganguly, CC BY 3.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">India's Authorised Pipeline Networks</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Length in km, by fuel type (2024–2026 PNGRB snapshots)</text>\n<line x1=\"180\" y1=\"75\" x2=\"180\" y2=\"235\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"99\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Natural gas</text>\n<rect x=\"180\" y=\"90\" width=\"400\" height=\"16\" fill=\"#0b5394\"/><text x=\"586\" y=\"104\" font-size=\"10\" fill=\"#212529\">~34,233 km</text>\n<text x=\"175\" y=\"149\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Petroleum products</text>\n<rect x=\"180\" y=\"140\" width=\"237\" height=\"16\" fill=\"#212529\"/><text x=\"423\" y=\"154\" font-size=\"10\" fill=\"#212529\">~20,259 km</text>\n<text x=\"175\" y=\"199\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">LPG (common carrier)</text>\n<rect x=\"180\" y=\"190\" width=\"111\" height=\"16\" fill=\"#1a8f4c\"/><text x=\"297\" y=\"204\" font-size=\"10\" fill=\"#212529\">~9,500 km</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "sugarcanes-third-claimant-whats": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Sugarcane_Field_Srirangapatna_Karnataka_Jul22_R16_06192.jpg/960px-Sugarcane_Field_Srirangapatna_Karnataka_Jul22_R16_06192.jpg\" alt=\"A sugarcane field in Srirangapatna, Karnataka, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Cane juice and molasses from fields like this one &mdash; not bagasse &mdash; are the feedstock being fermented into India's first industrial-scale PLA bioplastic plant. <a href=\"https://commons.wikimedia.org/wiki/File:Sugarcane_Field_Srirangapatna_Karnataka_Jul22_R16_06192.jpg\" rel=\"noopener noreferrer\">Sugarcane Field, Srirangapatna, Karnataka</a>, Timothy A. Gonsalves, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Balrampur Bioyug PLA Plant: Construction Progress</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">% complete, as of 31 July 2026 (Q1 FY27 investor presentation)</text>\n<line x1=\"180\" y1=\"75\" x2=\"180\" y2=\"235\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"99\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Model review</text>\n<rect x=\"180\" y=\"90\" width=\"376\" height=\"16\" fill=\"#1a8f4c\"/><text x=\"562\" y=\"104\" font-size=\"10\" fill=\"#212529\">94%</text>\n<text x=\"175\" y=\"149\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Civil work</text>\n<rect x=\"180\" y=\"140\" width=\"368\" height=\"16\" fill=\"#0b5394\"/><text x=\"554\" y=\"154\" font-size=\"10\" fill=\"#212529\">92%</text>\n<text x=\"175\" y=\"199\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Equipment erection</text>\n<rect x=\"180\" y=\"190\" width=\"272\" height=\"16\" fill=\"#c0392b\"/><text x=\"458\" y=\"204\" font-size=\"10\" fill=\"#212529\">68%</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "tasmacs-retail-exit-case-for": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/Ooty_TASMAC.jpg/960px-Ooty_TASMAC.jpg\" alt=\"A TASMAC state-run liquor shop in Ooty, Tamil Nadu\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A TASMAC retail outlet of the kind the Tamil Nadu government now plans to privatize roughly 2,500 of, while keeping wholesale distribution under state control. <a href=\"https://commons.wikimedia.org/wiki/File:Ooty_TASMAC.jpg\" rel=\"noopener noreferrer\">Ooty TASMAC</a>, Surajt88, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">State Liquor Revenue, FY2024-25</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">₹ crore, VAT+excise or equivalent, by state</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"225\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"79\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Uttar Pradesh</text>\n<rect x=\"180\" y=\"70\" width=\"400\" height=\"14\" fill=\"#495057\"/><text x=\"586\" y=\"82\" font-size=\"10\" fill=\"#212529\">₹52,573 cr</text>\n<text x=\"175\" y=\"119\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Tamil Nadu (TASMAC)</text>\n<rect x=\"180\" y=\"110\" width=\"368\" height=\"14\" fill=\"#0b5394\"/><text x=\"554\" y=\"122\" font-size=\"10\" fill=\"#212529\">₹48,344 cr</text>\n<text x=\"175\" y=\"159\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Maharashtra</text>\n<rect x=\"180\" y=\"150\" width=\"332\" height=\"14\" fill=\"#495057\"/><text x=\"518\" y=\"162\" font-size=\"10\" fill=\"#212529\">₹43,620 cr</text>\n<text x=\"175\" y=\"199\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Karnataka (hybrid)</text>\n<rect x=\"180\" y=\"190\" width=\"272\" height=\"14\" fill=\"#495057\"/><text x=\"458\" y=\"202\" font-size=\"10\" fill=\"#212529\">₹35,783.54 cr</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
