{
  "india-is-piping-jet-fuel-to-five-new": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a2/Aircraft_being_fueled_by_tanker.jpg/960px-Aircraft_being_fueled_by_tanker.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"A commercial aircraft being refuelled from a tanker truck on the tarmac\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Most Indian airports still receive jet fuel this way, by tanker truck, rather than through a dedicated pipeline. <a href=\"https://commons.wikimedia.org/wiki/File:Aircraft_being_fueled_by_tanker.jpg\" rel=\"noopener noreferrer\">Aircraft being fueled by tanker</a>, Kristoferb, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Six New ATF Pipelines, By Capacity</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Authorised or bid capacity, million tonnes a year (MMTPA)</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"219\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Bengaluru, 2nd line</text>\n<rect x=\"180\" y=\"70\" width=\"240\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"428\" y=\"81\" font-size=\"10\" fill=\"#212529\">2.5 MMTPA</text>\n<text x=\"175\" y=\"120\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Navi Mumbai</text>\n<rect x=\"180\" y=\"110\" width=\"428\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"616\" y=\"121\" font-size=\"10\" fill=\"#212529\">4.45 MMTPA</text>\n<text x=\"175\" y=\"160\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Noida (Jewar)</text>\n<rect x=\"180\" y=\"150\" width=\"441\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"629\" y=\"161\" font-size=\"10\" fill=\"#212529\">4.58 MMTPA</text>\n<text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Hyderabad</text>\n<rect x=\"180\" y=\"190\" width=\"480\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"668\" y=\"201\" font-size=\"10\" fill=\"#212529\">4.99 MMTPA</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "indias-draft-seeds-bill-cuts-states": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Women_Farmers_Sowing_in_Karnataka%2C_India.jpg/960px-Women_Farmers_Sowing_in_Karnataka%2C_India.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"Two women farmers sowing seeds by hand in a field in Karnataka, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">The draft Seeds Bill would regulate exactly this kind of seed sowing and sale across India, from registration to committee oversight. <a href=\"https://commons.wikimedia.org/wiki/File:Women_Farmers_Sowing_in_Karnataka,_India.jpg\" rel=\"noopener noreferrer\">Women Farmers Sowing in Karnataka, India</a>, Vraj Acharya, WELL Labs, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Central Seed Committee: State Seats Cut</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Number of seats, 1966 Act vs draft Seeds Bill, 2025</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"179\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">State seats, 1966 Act</text>\n<rect x=\"180\" y=\"70\" width=\"391\" height=\"14\" fill=\"#495057\"/><text x=\"579\" y=\"81\" font-size=\"10\" fill=\"#212529\">22 seats</text>\n<text x=\"175\" y=\"120\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">State seats, draft bill</text>\n<rect x=\"180\" y=\"110\" width=\"89\" height=\"14\" fill=\"#c0392b\"/><text x=\"277\" y=\"121\" font-size=\"10\" fill=\"#212529\">5 seats</text>\n<text x=\"175\" y=\"160\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Total committee, draft bill</text>\n<rect x=\"180\" y=\"150\" width=\"480\" height=\"14\" fill=\"#212529\"/><text x=\"668\" y=\"161\" font-size=\"10\" fill=\"#212529\">27 members</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "pngrbs-own-committee-found-pipelines": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/LPG_cylinder_%282013%29.jpg/960px-LPG_cylinder_%282013%29.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"A domestic LPG cooking-gas cylinder in India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Only 45% of India's LPG moves by pipeline, per the committee's own FY2023-24 tally; the rest still travels by road tanker or rail to bottling plants like the one that filled this cylinder. <a href=\"https://commons.wikimedia.org/wiki/File:LPG_cylinder_(2013).jpg\" rel=\"noopener noreferrer\">LPG cylinder (2013)</a>, Prabhupuducherry, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Pipeline Utilisation, FY26: 2% to 165%</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Selected pipelines from PNGRB's Expert Committee report</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"259\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Krishnapatnam–Hyderabad</text>\n<rect x=\"180\" y=\"70\" width=\"6\" height=\"14\" fill=\"#c0392b\"/><text x=\"194\" y=\"81\" font-size=\"10\" fill=\"#212529\">2%</text>\n<text x=\"175\" y=\"120\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Panipat–Delhi (PDPL)</text>\n<rect x=\"180\" y=\"110\" width=\"23\" height=\"14\" fill=\"#c0392b\"/><text x=\"211\" y=\"121\" font-size=\"10\" fill=\"#212529\">7.9%</text>\n<text x=\"175\" y=\"160\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Mathura–Delhi (MDPL)</text>\n<rect x=\"180\" y=\"150\" width=\"169\" height=\"14\" fill=\"#495057\"/><text x=\"357\" y=\"161\" font-size=\"10\" fill=\"#212529\">58.2%</text>\n<text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Chennai ATF</text>\n<rect x=\"180\" y=\"190\" width=\"437\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"625\" y=\"201\" font-size=\"10\" fill=\"#212529\">150.6%</text>\n<text x=\"175\" y=\"240\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Haldia–Mourigram–Rajbandh</text>\n<rect x=\"180\" y=\"230\" width=\"480\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"668\" y=\"241\" font-size=\"10\" fill=\"#212529\">165.3%</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "pngrb-wants-prepaid-smart-meters-on": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/b/b9/Diaphragm_gas_meter.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"A conventional diaphragm gas meter\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">PNGRB's committee recommends smart diaphragm meters like this one, keeping the same mechanical measurement but adding prepaid billing and remote shut-off. <a href=\"https://commons.wikimedia.org/wiki/File:Diaphragm_gas_meter.jpg\" rel=\"noopener noreferrer\">Diaphragm gas meter</a>, Sgridò, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Smart Meter Rollout Schedule</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Target share of connections converted, by phase</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"219\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Phase I, FY 2026-27</text>\n<rect x=\"180\" y=\"70\" width=\"24\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"212\" y=\"81\" font-size=\"10\" fill=\"#212529\">5% of billed connections</text>\n<text x=\"175\" y=\"120\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Phase II, FY 2027-28</text>\n<rect x=\"180\" y=\"110\" width=\"72\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"260\" y=\"121\" font-size=\"10\" fill=\"#212529\">15% of billed connections</text>\n<text x=\"175\" y=\"160\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Phase III, FY 2028-29</text>\n<rect x=\"180\" y=\"150\" width=\"120\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"308\" y=\"161\" font-size=\"10\" fill=\"#212529\">25% of total connections</text>\n<text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Phase IV, FY 2029-30</text>\n<rect x=\"180\" y=\"190\" width=\"480\" height=\"14\" fill=\"#212529\"/><text x=\"668\" y=\"201\" font-size=\"10\" fill=\"#212529\">Remaining total connections</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "a-2013-vision-saw-india-needing-746": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Kochi_LNG_Terminal.jpg/960px-Kochi_LNG_Terminal.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"The Kochi LNG import terminal in Kerala, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">The 2013 report bet on LNG imports like those landed here to close India's gas demand-supply gap; actual demand never caught up to that bet. <a href=\"https://commons.wikimedia.org/wiki/File:Kochi_LNG_Terminal.jpg\" rel=\"noopener noreferrer\">Kochi LNG Terminal</a>, Lucky2916, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Projected vs Actual Gas Demand (MMSCMD)</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">2013 industry forecast vs actual 2025 demand and PNGRB's 2025 outlook</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"179\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Actual demand, 2025</text>\n<rect x=\"180\" y=\"70\" width=\"127\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"315\" y=\"81\" font-size=\"10\" fill=\"#212529\">~197 MMSCMD</text>\n<text x=\"175\" y=\"120\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">PNGRB 2025 outlook for 2030 (high)</text>\n<rect x=\"180\" y=\"110\" width=\"235\" height=\"14\" fill=\"#495057\"/><text x=\"423\" y=\"121\" font-size=\"10\" fill=\"#212529\">364.6 MMSCMD</text>\n<text x=\"175\" y=\"160\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">2013 report's projection, 2029-30</text>\n<rect x=\"180\" y=\"150\" width=\"480\" height=\"14\" fill=\"#c0392b\"/><text x=\"668\" y=\"161\" font-size=\"10\" fill=\"#212529\">746 MMSCMD</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "fourteen-states-reimburse-investors": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/02/HyundaiChennai.JPG/960px-HyundaiChennai.JPG?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"Hyundai's automobile manufacturing plant near Chennai, Tamil Nadu\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Tamil Nadu, home to plants like this one, is among the fourteen states offering investors a budget subsidy pegged to their SGST payments. <a href=\"https://commons.wikimedia.org/wiki/File:HyundaiChennai.JPG\" rel=\"noopener noreferrer\">HyundaiChennai</a>, L.vivian.richard, Public domain, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">SGST Reimbursement Share, Selected States</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Share of net or gross SGST paid back to qualifying investors</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"259\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Rajasthan (RIPS 2024)</text>\n<rect x=\"180\" y=\"70\" width=\"360\" height=\"14\" fill=\"#495057\"/><text x=\"548\" y=\"81\" font-size=\"10\" fill=\"#212529\">75%</text>\n<text x=\"175\" y=\"120\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Punjab (IBDP 2026)</text>\n<rect x=\"180\" y=\"110\" width=\"360\" height=\"14\" fill=\"#495057\"/><text x=\"548\" y=\"121\" font-size=\"10\" fill=\"#212529\">75%</text>\n<text x=\"175\" y=\"160\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Odisha (IPR 2022)</text>\n<rect x=\"180\" y=\"150\" width=\"480\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"668\" y=\"161\" font-size=\"10\" fill=\"#212529\">100%</text>\n<text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Assam (2021, amended 2024)</text>\n<rect x=\"180\" y=\"190\" width=\"480\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"668\" y=\"201\" font-size=\"10\" fill=\"#212529\">100%</text>\n<text x=\"175\" y=\"240\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Tamil Nadu (IP 2021)</text>\n<rect x=\"180\" y=\"230\" width=\"480\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"668\" y=\"241\" font-size=\"10\" fill=\"#212529\">100%</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "indias-gas-pipelines-run-at-half": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/3/32/Jamnagar_Refinery.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"The Jamnagar oil refinery complex in Gujarat, India, lit up at night\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">India's oil and product pipelines feed refineries like this one and mostly run close to full, unlike the gas trunk grid this piece contrasts them with. <a href=\"https://commons.wikimedia.org/wiki/File:Jamnagar_Refinery.jpg\" rel=\"noopener noreferrer\">Jamnagar Refinery</a>, Reliance Industries, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Gas vs Oil Pipeline Utilisation</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Share of capacity used, by network and source</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"219\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Gas grid — IEEFA estimate</text>\n<rect x=\"180\" y=\"70\" width=\"215\" height=\"14\" fill=\"#c0392b\"/><text x=\"403\" y=\"81\" font-size=\"10\" fill=\"#212529\">41%</text>\n<text x=\"175\" y=\"120\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Gas grid — PNGRB chairman, 2025</text>\n<rect x=\"180\" y=\"110\" width=\"262\" height=\"14\" fill=\"#c0392b\"/><text x=\"450\" y=\"121\" font-size=\"10\" fill=\"#212529\">~50%</text>\n<text x=\"175\" y=\"160\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Multi-product pipelines, Apr–Nov 2025</text>\n<rect x=\"180\" y=\"150\" width=\"364\" height=\"14\" fill=\"#495057\"/><text x=\"552\" y=\"161\" font-size=\"10\" fill=\"#212529\">69.40%</text>\n<text x=\"175\" y=\"200\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Numaligarh–Siliguri crude line, FY24-25</text>\n<rect x=\"180\" y=\"190\" width=\"480\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"668\" y=\"201\" font-size=\"10\" fill=\"#212529\">91.46%</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "mapping-indias-other-pipelines-every": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/9/9c/Haldia_Refinery.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"Haldia Refinery in West Bengal, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Haldia anchors two of the crude and LPG lines this piece maps, including the Paradip–Haldia–Barauni crude trunk line. <a href=\"https://commons.wikimedia.org/wiki/File:Haldia_Refinery.jpg\" rel=\"noopener noreferrer\">Haldia Refinery</a>, Indian Oil Corporation, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">India's Product Pipeline Network, By Company</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Combined dedicated + common-carrier length, km (PNGRB-commissioned study)</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"179\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"80\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">BPCL</text>\n<rect x=\"180\" y=\"70\" width=\"141\" height=\"14\" fill=\"#495057\"/><text x=\"329\" y=\"81\" font-size=\"10\" fill=\"#212529\">3,397 km</text>\n<text x=\"175\" y=\"120\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">HPCL</text>\n<rect x=\"180\" y=\"110\" width=\"191\" height=\"14\" fill=\"#495057\"/><text x=\"379\" y=\"121\" font-size=\"10\" fill=\"#212529\">4,609 km</text>\n<text x=\"175\" y=\"160\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Indian Oil</text>\n<rect x=\"180\" y=\"150\" width=\"480\" height=\"14\" fill=\"#1a8f4c\"/><text x=\"668\" y=\"161\" font-size=\"10\" fill=\"#212529\">11,593 km</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "pngrbs-own-2025-committee-now-expects": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Kochi_LNG_Terminal_DSW.jpg/960px-Kochi_LNG_Terminal_DSW.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"The Kochi LNG import terminal in Kerala, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">The 2025 committee's own infrastructure table lists this Kochi terminal running at just 22.0% utilisation, one of the report's named examples of underused gas infrastructure. <a href=\"https://commons.wikimedia.org/wiki/File:Kochi_LNG_Terminal_DSW.jpg\" rel=\"noopener noreferrer\">Kochi LNG Terminal DSW</a>, Augustus Binu / www.dreamsparrow.net, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>",
