  "five-year-synthesis-trade-currency": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/a/a8/Reserve_Bank_of_India_Building.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"The Reserve Bank of India building\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">The rupee and forex-reserves series this five-year synthesis re-cuts are the RBI's own numbers. <a href=\"https://commons.wikimedia.org/wiki/File:Reserve_Bank_of_India_Building.jpg\" rel=\"noopener noreferrer\">Reserve Bank of India Building.jpg</a>, Schwiki, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>"
