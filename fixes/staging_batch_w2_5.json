  "foreign-capital-found-indias-hospitals": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Apollo_Hospital%2C_Hyderabad.jpg/960px-Apollo_Hospital%2C_Hyderabad.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"An Apollo Hospitals building in Hyderabad\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Apollo Hospitals is exactly the kind of existing chain that foreign private-equity and sovereign-fund capital has been buying into, rather than funding new beds. <a href=\"https://commons.wikimedia.org/wiki/File:Apollo_Hospital,_Hyderabad.jpg\" rel=\"noopener noreferrer\">Apollo Hospital, Hyderabad.jpg</a>, Hindustanilanguage, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "fourteen-years-of-indian-wholesale": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/India_-_Koyambedu_Market_-_Market_03_%283987093932%29.jpg/960px-India_-_Koyambedu_Market_-_Market_03_%283987093932%29.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"Wholesale vegetable market at Koyambedu, Chennai\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Food and primary articles like the produce traded here are the two fastest-rising categories in fourteen years of the Wholesale Price Index. <a href=\"https://commons.wikimedia.org/wiki/File:India_-_Koyambedu_Market_-_Market_03_(3987093932).jpg\" rel=\"noopener noreferrer\">India - Koyambedu Market - Market 03 (3987093932).jpg</a>, McKay Savage from London, UK, CC BY 2.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "from-barrel-to-bottle-petrochemical": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/f/fe/LPG_cylinder.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"A domestic LPG cylinder\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A standard steel domestic cylinder like this one is the baseline this piece weighs against the newer composite alternative. <a href=\"https://commons.wikimedia.org/wiki/File:LPG_cylinder.jpg\" rel=\"noopener noreferrer\">LPG cylinder.jpg</a>, Ks.mini, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "from-cane-to-code-digital-layer": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Harvesting_Sugarcane_Doddagowdana_Koppalu_Aug24_A7CR_02231.jpg/960px-Harvesting_Sugarcane_Doddagowdana_Koppalu_Aug24_A7CR_02231.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"Farmers harvesting sugarcane in India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Sugarcane like this is the feedstock underneath India's ethanol-blending build-out, and the crop the satellite and AI tools in this piece are being layered onto. <a href=\"https://commons.wikimedia.org/wiki/File:Harvesting_Sugarcane_Doddagowdana_Koppalu_Aug24_A7CR_02231.jpg\" rel=\"noopener noreferrer\">Harvesting Sugarcane Doddagowdana Koppalu Aug24 A7CR 02231.jpg</a>, Timothy A. Gonsalves, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "fuel-and-bottle-two-taxes-states-never": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Shankar_Nagar_Petrol_Pump%2C_Nagpur.jpg/960px-Shankar_Nagar_Petrol_Pump%2C_Nagpur.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"A petrol pump in Nagpur, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Fuel VAT collected at pumps like this one is the larger of the two taxes states never handed over to GST. <a href=\"https://commons.wikimedia.org/wiki/File:Shankar_Nagar_Petrol_Pump,_Nagpur.jpg\" rel=\"noopener noreferrer\">Shankar Nagar Petrol Pump, Nagpur.jpg</a>, Slyronit, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "fuel-pricing-to-crude-cost": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/Petrol_pump%2C_Nagpur%2C_India.jpg/960px-Petrol_pump%2C_Nagpur%2C_India.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"A petrol pump dispensing fuel in India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">The retail selling price built up at the pump, not the crude price itself, is what this piece decomposes litre by litre. <a href=\"https://commons.wikimedia.org/wiki/File:Petrol_pump,_Nagpur,_India.jpg\" rel=\"noopener noreferrer\">Petrol pump, Nagpur, India.jpg</a>, Ganesh Dhamodkar, CC BY 1.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "fy2025-26-sample-report-india-trade": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/2/28/Jawaharlal_Nehru_Trust_Port.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"Jawaharlal Nehru Port, India's largest container port\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Merchandise trade like the containers moved through JNPT is the first pillar of this FY2025-26 snapshot. <a href=\"https://commons.wikimedia.org/wiki/File:Jawaharlal_Nehru_Trust_Port.jpg\" rel=\"noopener noreferrer\">Jawaharlal Nehru Trust Port.jpg</a>, Jaxer, CC BY 3.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "global-biofuels-m-bankruptcy-bolt-on": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/1/18/Argent_Energy_Biodiesel_Plant_-_geograph.org.uk_-_232328.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"A biodiesel production plant\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Plants like this one are the kind of biodiesel-feedstock and renewable-diesel asset changing hands in the bankruptcy, bolt-on and growth-capital deals this piece tracks. <a href=\"https://commons.wikimedia.org/wiki/File:Argent_Energy_Biodiesel_Plant_-_geograph.org.uk_-_232328.jpg\" rel=\"noopener noreferrer\">Argent Energy Biodiesel Plant - geograph.org.uk - 232328.jpg</a>, Chris Upson, CC BY-SA 2.0, via Wikimedia Commons.</figcaption>\n</figure>"
