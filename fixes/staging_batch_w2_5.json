  "financing-fuel-to-chemicals-pivot-how": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/9/9c/Haldia_Refinery.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"Haldia Refinery, one of the state refineries now adding petrochemical capacity\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Indian Oil's refineries, like this one at Haldia, are the assets taking on the debt-funded fuel-to-chemicals build-out this piece maps. <a href=\"https://commons.wikimedia.org/wiki/File:Haldia_Refinery.jpg\" rel=\"noopener noreferrer\">Haldia Refinery.jpg</a>, Indian Oil Corporation, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
