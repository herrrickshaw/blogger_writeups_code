  "pli-medical-devices-coverage-and-gaps": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2d/An_MRI_scanner.JPG/960px-An_MRI_scanner.JPG?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"A Philips MRI scanner in a hospital imaging room\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">MRI imaging is the segment where India's PLI scheme has visibly worked, with Philips MRI-coil exports alone reaching over ₹2,187 crore cumulatively. <a href=\"https://commons.wikimedia.org/wiki/File:An_MRI_scanner.JPG\" rel=\"noopener noreferrer\">An MRI scanner.JPG</a>, Walter Davies, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "india-grows-most-coconuts-in-world-and": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Coconut_Tree_Farm.JPG/960px-Coconut_Tree_Farm.JPG?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"A coconut tree farm in Kerala, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A coconut farm in Kerala — the state with the most land under coconut cultivation in India, and the lowest yield per hectare among the big four producing states. <a href=\"https://commons.wikimedia.org/wiki/File:Coconut_Tree_Farm.JPG\" rel=\"noopener noreferrer\">Coconut Tree Farm.JPG</a>, Ranjithsiji, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "the-recycling-lottery-playbook-norways": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Sven_Mollekleiv_ved_en_panteautomat_med_pantelotteriet_Panto..jpeg/960px-Sven_Mollekleiv_ved_en_panteautomat_med_pantelotteriet_Panto..jpeg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"Norwegian Red Cross president Sven Mollekleiv beside a Pantelotteriet bottle-return lottery machine\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Norway's Pantelotteriet turns a bottle-deposit refund into a lottery ticket, with proceeds from non-winning tickets funding the Norwegian Red Cross — the model this piece proposes adapting for Jal Jeevan. <a href=\"https://commons.wikimedia.org/wiki/File:Sven_Mollekleiv_ved_en_panteautomat_med_pantelotteriet_Panto..jpeg\" rel=\"noopener noreferrer\">Sven Mollekleiv ved en panteautomat med pantelotteriet Panto..jpeg</a>, Apeland Informasjon/Katrine Lunke, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "the-rule-of-72-rule-of-114-and-how-to": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/f/f1/Stack_of_indian_rupee.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail_unscaled\" alt=\"A stack of Indian rupee banknotes\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A stack of Indian rupee notes — the kind of principal sum the Rule of 72 lets you mentally project forward at a stated interest rate, like PPF's 7.1%. <a href=\"https://commons.wikimedia.org/wiki/File:Stack_of_indian_rupee.jpg\" rel=\"noopener noreferrer\">Stack of indian rupee.jpg</a>, Vinoth offl, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "indias-animal-protein-export-complex": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Prawn_Farm_1-IMG_0548_by_Joseph_Lazer.jpg/960px-Prawn_Farm_1-IMG_0548_by_Joseph_Lazer.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"A prawn farm in Kerala, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A prawn farm in Kerala — frozen shrimp now makes up roughly two-thirds of India's record ₹72,325.82 crore seafood export earnings, alongside the buffalo-meat and rendering-tallow businesses this piece covers. <a href=\"https://commons.wikimedia.org/wiki/File:Prawn_Farm_1-IMG_0548_by_Joseph_Lazer.jpg\" rel=\"noopener noreferrer\">Prawn Farm 1-IMG 0548 by Joseph Lazer.jpg</a>, Joseph Lazer, CC BY-SA 2.5, via Wikimedia Commons.</figcaption>\n</figure>"
  },
  "what-actually-happens-to-indias-used": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/98/Changing_engine_oil_in_a_workshop.jpg/960px-Changing_engine_oil_in_a_workshop.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=imageinfo&amp;utm_content=thumbnail\" alt=\"A mechanic draining used engine oil during a service in a workshop\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Draining used engine oil during a routine service — the hazardous waste stream now subject to India's 2023 Extended Producer Responsibility recycling target. <a href=\"https://commons.wikimedia.org/wiki/File:Changing_engine_oil_in_a_workshop.jpg\" rel=\"noopener noreferrer\">Changing engine oil in a workshop.jpg</a>, Shixart1985, CC BY 2.0, via Wikimedia Commons.</figcaption>\n</figure>"
