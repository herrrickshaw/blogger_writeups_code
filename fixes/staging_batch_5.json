  "west-bengal-sanctioned-126-lakh-pmay-g": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Earthen_and_concrete_houses.jpg/960px-Earthen_and_concrete_houses.jpg\" alt=\"A mud house next to a cemented (pucca) house in rural West Bengal\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A mud (kutcha) house beside a cemented (pucca) house in Santiniketan, West Bengal &mdash; the kind of upgrade PMAY-G funds, and which the state's funds freeze has stalled. <a href=\"https://commons.wikimedia.org/wiki/File:Earthen_and_concrete_houses.jpg\" rel=\"noopener noreferrer\">Earthen and concrete houses</a>, Sagnik Samanta, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">PMAY-G Completion Rate, FY2021-22–FY2025-26</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">% of 5-year target completed &middot; Lok Sabha answer, 11 Aug 2026</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"365\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"94\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">National</text>\n<rect x=\"180\" y=\"80\" width=\"366\" height=\"18\" fill=\"#0b5394\"/><text x=\"552\" y=\"94\" font-size=\"10\" fill=\"#212529\">56.6%</text>\n<text x=\"175\" y=\"148\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Assam</text>\n<rect x=\"180\" y=\"135\" width=\"460\" height=\"18\" fill=\"#1a8f4c\"/><text x=\"646\" y=\"148\" font-size=\"10\" fill=\"#212529\">71.2%</text>\n<text x=\"175\" y=\"204\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Bihar</text>\n<rect x=\"180\" y=\"190\" width=\"428\" height=\"18\" fill=\"#1a8f4c\"/><text x=\"614\" y=\"204\" font-size=\"10\" fill=\"#212529\">66.3%</text>\n<text x=\"175\" y=\"258\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Madhya Pradesh</text>\n<rect x=\"180\" y=\"245\" width=\"367\" height=\"18\" fill=\"#1a8f4c\"/><text x=\"553\" y=\"258\" font-size=\"10\" fill=\"#212529\">56.8%</text>\n<text x=\"175\" y=\"314\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">West Bengal</text>\n<rect x=\"180\" y=\"300\" width=\"78\" height=\"18\" fill=\"#c0392b\"/><text x=\"264\" y=\"314\" font-size=\"10\" fill=\"#212529\">12.1%</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "what-seven-model-stock-portfolios-look": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/0/04/BSE_-_Bombay_Stock_Exchange_Building.jpg/960px-BSE_-_Bombay_Stock_Exchange_Building.jpg\" alt=\"The Bombay Stock Exchange building in Mumbai, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">The Bombay Stock Exchange in Mumbai &mdash; one of the two markets (India and US) the eight-factor stock-picking system behind these seven model portfolios screens. <a href=\"https://commons.wikimedia.org/wiki/File:BSE_-_Bombay_Stock_Exchange_Building.jpg\" rel=\"noopener noreferrer\">BSE - Bombay Stock Exchange Building</a>, Niyantha Shekhar, CC BY 2.0, via Wikimedia Commons.</figcaption>\n</figure>",
