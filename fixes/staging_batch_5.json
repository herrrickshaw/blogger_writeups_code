  "uk-retail-canopies-at-54m-real-design": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/f/f9/Petrol_station_canopy%2C_Dundonald_-_geograph.org.uk_-_3417930.jpg\" alt=\"A petrol station forecourt canopy in the UK\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A UK forecourt canopy of the kind whose clearance height this piece checks against DMRB CD 127 and the one confirmed planning case, MFG's Auchinleck site. <a href=\"https://commons.wikimedia.org/wiki/File:Petrol_station_canopy,_Dundonald_-_geograph.org.uk_-_3417930.jpg\" rel=\"noopener noreferrer\">Petrol station canopy, Dundonald</a>, Albert Bridge, CC BY-SA 2.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">UK Canopy Clearance: Claimed vs. Confirmed</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Headroom in metres &middot; DMRB CD 127 and the Auchinleck planning case</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"365\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"105\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Auchinleck, before</text>\n<rect x=\"180\" y=\"90\" width=\"383\" height=\"20\" fill=\"#495057\"/><text x=\"569\" y=\"105\" font-size=\"10\" fill=\"#212529\">4.5m</text>\n<text x=\"175\" y=\"173\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">DMRB CD 127 standard</text>\n<rect x=\"180\" y=\"158\" width=\"428\" height=\"20\" fill=\"#0b5394\"/><text x=\"614\" y=\"173\" font-size=\"10\" fill=\"#212529\">5.03m</text>\n<text x=\"175\" y=\"241\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Auchinleck, approved</text>\n<rect x=\"180\" y=\"226\" width=\"434\" height=\"20\" fill=\"#1a8f4c\"/><text x=\"620\" y=\"241\" font-size=\"10\" fill=\"#212529\">5.1m</text>\n<text x=\"175\" y=\"309\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Industry \"modern standard\"</text>\n<rect x=\"180\" y=\"294\" width=\"460\" height=\"20\" fill=\"#c0392b\"/><text x=\"646\" y=\"309\" font-size=\"10\" fill=\"#212529\">5.4m</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
