  "tnpl-has-made-paper-from-sugarcane_0974259386": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/6/67/Pakka_bagasse_pulp_processing.jpg/960px-Pakka_bagasse_pulp_processing.jpg\" alt=\"Bagasse (sugarcane residue) pulp being processed at a paper mill in India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Bagasse pulp &mdash; the fibrous sugarcane residue TNPL has run its Karur pulping lines on since 1984 &mdash; being processed at an Indian paper mill. <a href=\"https://commons.wikimedia.org/wiki/File:Pakka_bagasse_pulp_processing.jpg\" rel=\"noopener noreferrer\">Pakka bagasse pulp processing</a>, Pakka Limited, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">TNPL's Karur Pulping Lines by Furnish Type</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Tonnes/day (tpd), as of 31 March 2025 &middot; total 1,580 tpd</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"365\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"105\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Chemical bagasse pulping</text>\n<rect x=\"180\" y=\"90\" width=\"347\" height=\"20\" fill=\"#1a8f4c\"/><text x=\"533\" y=\"105\" font-size=\"10\" fill=\"#212529\">550 tpd</text>\n<text x=\"175\" y=\"195\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Hardwood pulping</text>\n<rect x=\"180\" y=\"180\" width=\"460\" height=\"20\" fill=\"#0b5394\"/><text x=\"646\" y=\"195\" font-size=\"10\" fill=\"#212529\">730 tpd</text>\n<text x=\"175\" y=\"285\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Deinked wastepaper pulp</text>\n<rect x=\"180\" y=\"270\" width=\"189\" height=\"20\" fill=\"#495057\"/><text x=\"375\" y=\"285\" font-size=\"10\" fill=\"#212529\">300 tpd</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
  "top-15-chemicals-for-import--4751284523575450171": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/OPaL_Dahej_Project_Panorama_View.jpg/960px-OPaL_Dahej_Project_Panorama_View.jpg\" alt=\"Panoramic view of the OPaL petrochemical complex at Dahej, Gujarat, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A large Indian petrochemical complex (OPaL, Dahej, Gujarat) of the kind this roadmap's import-substitution capex &mdash; polymer crackers, PP and PE lines &mdash; is meant to build out domestically. <a href=\"https://commons.wikimedia.org/wiki/File:OPaL_Dahej_Project_Panorama_View.jpg\" rel=\"noopener noreferrer\">OPaL Dahej Project Panorama View</a>, Rajiv Nair EIL, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
