  "what-sewage-disposal-in-key-parts-of_0568573871": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7e/Anopheles_stephensi.jpeg/960px-Anopheles_stephensi.jpeg\" alt=\"Anopheles stephensi, the mosquito that carries malaria in urban India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Anopheles stephensi &mdash; the malaria-carrying mosquito that favours the stagnant, dirty water upgraded drainage displaces, unlike dengue's Aedes. Anopheles stephensi, Jim Gathany/CDC, public domain, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Tamil Nadu Disease Case Counts: Malaria vs. Dengue</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Reported cases &middot; malaria's Anopheles favours drains; dengue's Aedes does not</text>\n<line x1=\"180\" y1=\"65\" x2=\"180\" y2=\"365\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"175\" y=\"105\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Malaria, Tamil Nadu, 2015</text>\n<rect x=\"180\" y=\"90\" width=\"94\" height=\"20\" fill=\"#0b5394\"/><text x=\"280\" y=\"105\" font-size=\"10\" fill=\"#212529\">5,587</text>\n<text x=\"175\" y=\"173\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Dengue, Tamil Nadu, 2024</text>\n<rect x=\"180\" y=\"158\" width=\"460\" height=\"20\" fill=\"#c0392b\"/><text x=\"646\" y=\"173\" font-size=\"10\" fill=\"#212529\">27,378</text>\n<text x=\"175\" y=\"241\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Dengue, TN, 2025 (The Federal)</text>\n<rect x=\"180\" y=\"226\" width=\"265\" height=\"20\" fill=\"#c0392b\"/><text x=\"451\" y=\"241\" font-size=\"10\" fill=\"#212529\">15,796</text>\n<text x=\"175\" y=\"309\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Dengue, TN, 2025 (provisional, other source)</text>\n<rect x=\"180\" y=\"294\" width=\"351\" height=\"20\" fill=\"#c0392b\"/><text x=\"537\" y=\"309\" font-size=\"10\" fill=\"#212529\">20,866</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
  },
