  "indias-lng-terminal-rules-changed-twice": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9b/%E0%B4%AA%E0%B5%86%E0%B4%9F%E0%B5%8D%E0%B4%B0%E0%B5%8B%E0%B4%A8%E0%B5%86%E0%B4%B1%E0%B5%8D%E0%B4%B1%E0%B5%8D_%E0%B4%8E%E0%B5%BD.%E0%B4%8E%E0%B5%BB.%E0%B4%9C%E0%B4%BF.%E0%B4%AF%E0%B5%81%E0%B4%9F%E0%B5%86_%E0%B4%B5%E0%B4%BE%E0%B4%A4%E0%B4%95_%E0%B4%9F%E0%B4%BE%E0%B4%99%E0%B5%8D%E0%B4%95%E0%B5%81%E0%B4%95%E0%B5%BE.jpg/960px-%E0%B4%AA%E0%B5%86%E0%B4%9F%E0%B5%8D%E0%B4%B0%E0%B5%8B%E0%B4%A8%E0%B5%86%E0%B4%B1%E0%B5%8D%E0%B4%B1%E0%B5%8D_%E0%B4%8E%E0%B5%BD.%E0%B4%8E%E0%B5%BB.%E0%B4%9C%E0%B4%BF.%E0%B4%AF%E0%B5%81%E0%B4%9F%E0%B5%86_%E0%B4%B5%E0%B4%BE%E0%B4%A4%E0%B4%95_%E0%B4%9F%E0%B4%BE%E0%B4%99%E0%B5%8D%E0%B4%95%E0%B5%81%E0%B4%95%E0%B5%BE.jpg\" alt=\"Petronet LNG's gas storage tanks at Puthuvype, Kochi, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">An existing Indian LNG import terminal's storage tanks — the kind of onshore infrastructure a Gravity-Based Structure like Kakinada's is designed as an offshore alternative to. <a href=\"https://commons.wikimedia.org/wiki/File:%E0%B4%AA%E0%B5%86%E0%B4%9F%E0%B5%8D%E0%B4%B0%E0%B5%8B%E0%B4%A8%E0%B5%86%E0%B4%B1%E0%B5%8D%E0%B4%B1%E0%B5%8D_%E0%B4%8E%E0%B5%BD.%E0%B4%8E%E0%B5%BB.%E0%B4%9C%E0%B4%BF.%E0%B4%AF%E0%B5%81%E0%B4%9F%E0%B5%86_%E0%B4%B5%E0%B4%BE%E0%B4%A4%E0%B4%95_%E0%B4%9F%E0%B4%BE%E0%B4%99%E0%B5%8D%E0%B4%95%E0%B5%81%E0%B4%95%E0%B5%BE.jpg\" rel=\"noopener noreferrer\">പെട്രോനെറ്റ് എൽ.എൻ.ജി.യുടെ വാതക ടാങ്കുകൾ</a>, Drajay1976, CC BY-SA 3.0, via Wikimedia Commons.</figcaption>\n</figure>",
    "chart_html": "<figure style=\"margin:1.6rem 0\"><svg role=\"img\" style=\"width:100%;height:auto;max-width:700px;display:block;margin:0 auto\" viewBox=\"0 0 700 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Georgia,'Times New Roman',serif\">\n<rect x=\"0\" y=\"0\" width=\"700\" height=\"400\" fill=\"#f8f9fa\"/>\n<text x=\"350\" y=\"30\" text-anchor=\"middle\" font-size=\"17\" font-weight=\"700\" fill=\"#212529\">Kakinada's GBS Terminal, Key Stats</text>\n<text x=\"350\" y=\"49\" text-anchor=\"middle\" font-size=\"12\" fill=\"#495057\">Crown LNG / KGLNG, as reported in this piece (Section 2)</text>\n<line x1=\"190\" y1=\"65\" x2=\"190\" y2=\"155\" stroke=\"#212529\" stroke-width=\"1.5\"/>\n<text x=\"185\" y=\"90\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Distance offshore (km)</text>\n<rect x=\"190\" y=\"76\" width=\"360\" height=\"18\" fill=\"#495057\"/><text x=\"558\" y=\"86\" font-size=\"10\" fill=\"#212529\">~11 km</text>\n<text x=\"185\" y=\"130\" text-anchor=\"end\" font-size=\"11\" fill=\"#212529\">Planned capacity (MTPA)</text>\n<rect x=\"190\" y=\"116\" width=\"236\" height=\"18\" fill=\"#1a8f4c\"/><text x=\"434\" y=\"126\" font-size=\"10\" fill=\"#212529\">~7.2 million tonnes/yr</text>\n</svg><figcaption class=\"gb-note\" style=\"margin-top:.4rem\">Source: figures as stated in this article.</figcaption></figure>"
