  "indias-79-lakh-crore-rural-water": {
    "picture_html": "<figure style=\"margin:1.6rem 0\">\n<img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6a/Overhead_water_tank_rural_Raichur_Karnataka_India_water_tower.jpg/960px-Overhead_water_tank_rural_Raichur_Karnataka_India_water_tower.jpg\" alt=\"An overhead water tank in a village in Raichur district, Karnataka, India\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:6px;display:block\"/>\n<figcaption class=\"gb-note\" style=\"margin-top:.4rem\">A rural overhead water tank of exactly the kind Jal Jeevan Mission's single- and multi-village schemes are built to feed. <a href=\"https://commons.wikimedia.org/wiki/File:Overhead_water_tank_rural_Raichur_Karnataka_India_water_tower.jpg\" rel=\"noopener noreferrer\">Overhead water tank rural Raichur Karnataka India water tower</a>, Vraj Acharya, WELL Labs, CC BY-SA 4.0, via Wikimedia Commons.</figcaption>\n</figure>",
